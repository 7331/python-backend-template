name: {{ project_slug }}

x-backend-image: &backend_image
  build:
    context: .
    dockerfile: backend/Dockerfile
  image: {{ project_slug }}/backend:local

x-backend-hardening: &backend_hardening
  read_only: true
  tmpfs:
    - /tmp:size=16m,mode=1777
  cap_drop:
    - ALL
  security_opt:
    - no-new-privileges:true
  logging:
    driver: json-file
    options:
      max-size: "20m"
      max-file: "5"

x-backend-environment-file: &backend_environment_file
  path: ${ {{- environment_prefix }}_ENVIRONMENT_FILE:-.env}
  required: true
{%- if include_postgres %}

x-database-owner-environment-file: &database_owner_environment_file
  path: ${ {{- environment_prefix }}_DATABASE_OWNER_ENVIRONMENT_FILE:-.env.database-owner}
  required: true
{%- endif %}

services:
{%- if include_postgres %}
  postgres:
    image: postgres:18-alpine
    env_file:
      - *database_owner_environment_file
    restart: unless-stopped
    command:
      - postgres
      - -c
      - shared_preload_libraries=pg_stat_statements
      - -c
      - max_connections=100
      - -c
      - shared_buffers=${POSTGRES_SHARED_BUFFERS:-256MB}
      - -c
      - effective_cache_size=${POSTGRES_EFFECTIVE_CACHE_SIZE:-768MB}
      - -c
      - work_mem=${POSTGRES_WORK_MEM:-8MB}
      - -c
      - maintenance_work_mem=${POSTGRES_MAINTENANCE_WORK_MEM:-64MB}
      - -c
      - log_min_duration_statement=500ms
      - -c
      - log_parameter_max_length=0
      - -c
      - log_lock_waits=on
      - -c
      - log_temp_files=0
      - -c
      - log_autovacuum_min_duration=1s
      - -c
      - "log_line_prefix=%m [%p] %q%u@%d app=%a sqlstate=%e query_id=%Q "
      - -c
      - archive_mode=${POSTGRES_ARCHIVE_MODE:-off}
      - -c
      - archive_timeout=60
      - -c
      - archive_command=wal-g wal-push %p
      - -c
      - restore_command=wal-g wal-fetch %f %p
    shm_size: 128mb
    environment:
      POSTGRES_DB: {{ database_name }}
      POSTGRES_USER: {{ database_name }}
    volumes:
      - postgres_data:/var/lib/postgresql
    networks:
      - backend_data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ database_name }} -d {{ database_name }}"]
      interval: 2s
      timeout: 5s
      retries: 30

  migrate:
    <<: [*backend_image, *backend_hardening]
    env_file:
      - *backend_environment_file
      - *database_owner_environment_file
    restart: "no"
    command: ["alembic", "upgrade", "heads"]
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - backend_data
{% endif %}
  api:
    <<: [*backend_image, *backend_hardening]
    env_file:
      - *backend_environment_file
    restart: unless-stopped
    command: ["python", "-m", "app", "serve-api"]
    stop_grace_period: 25s
{%- if include_postgres %}
    depends_on:
      migrate:
        condition: service_completed_successfully
{%- endif %}
    ports:
      - "127.0.0.1:${API_PUBLISH_PORT:-8000}:8000"
    networks:
{%- if include_postgres %}
      - backend_data
{%- endif %}
      - backend_egress
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=4)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
      start_interval: 2s
{%- if include_worker %}

  worker:
    <<: [*backend_image, *backend_hardening]
    env_file:
      - *backend_environment_file
    restart: unless-stopped
    command: ["python", "-m", "app", "run-worker"]
    stop_grace_period: 25s
    depends_on:
      migrate:
        condition: service_completed_successfully
    networks:
      - backend_data
      - backend_egress
    healthcheck:
      test: ["CMD", "python", "-m", "app.worker_healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
      start_interval: 2s
{%- endif %}
{%- if include_object_storage %}

  object-storage:
    image: versity/versitygw:v1.11.0@sha256:8319a530d08d537426e2f855bae5280709795dc73a3f0c347973ef915d6343c5
    restart: unless-stopped
    entrypoint: ["/bin/sh", "-c", "mkdir -p \"/data/$$OBJECT_STORAGE_BUCKET\" && exec versitygw posix /data"]
    environment:
      ROOT_ACCESS_KEY: ${ {{- environment_prefix }}_OBJECT_STORAGE_ACCESS_KEY_ID:?set {{ environment_prefix }}_OBJECT_STORAGE_ACCESS_KEY_ID in the env file}
      ROOT_SECRET_KEY: ${ {{- environment_prefix }}_OBJECT_STORAGE_SECRET_ACCESS_KEY:?set {{ environment_prefix }}_OBJECT_STORAGE_SECRET_ACCESS_KEY in the env file}
      OBJECT_STORAGE_BUCKET: ${ {{- environment_prefix }}_OBJECT_STORAGE_BUCKET:-{{ project_slug }}}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"
    volumes:
      - object_storage_data:/data
    ports:
      - "127.0.0.1:${OBJECT_STORAGE_PUBLISH_PORT:-9000}:7070"
    networks:
      - backend_egress
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "7070"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
      start_interval: 2s
{%- endif %}

networks:
{%- if include_postgres %}
  backend_data:
    internal: true
{%- endif %}
  backend_egress: {}
{%- if include_postgres %}

volumes:
  postgres_data: {}
{%- endif %}
{%- if include_object_storage %}
  object_storage_data: {}
{%- endif %}
