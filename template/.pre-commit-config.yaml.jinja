default_install_hook_types: [pre-commit, pre-push, commit-msg]
default_stages: [pre-push, manual]

repos:
  - repo: builtin
    hooks:
      - id: check-merge-conflict
        args: [--assume-in-merge]
        stages: [pre-commit, pre-push, manual]
  - repo: local
    hooks:
      - id: lint-fix
        name: ruff check --fix (changed files)
        entry: uv run --project backend ruff check --fix --force-exclude
        language: system
        files: ^(backend|e2e)/
        types: [python]
        require_serial: true
        stages: [pre-commit]
      - id: format-fix
        name: ruff format (changed files)
        entry: uv run --project backend ruff format --force-exclude
        language: system
        files: ^(backend|e2e)/
        types: [python]
        require_serial: true
        stages: [pre-commit]
      - id: gitleaks-staged
        name: gitleaks (staged changes)
        entry: gitleaks git --pre-commit --staged --redact --verbose --no-banner
        language: golang
        language_version: 1.25.4
        additional_dependencies: [github.com/zricethezav/gitleaks/v8@v8.30.1]
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
      - id: backend-sync
        name: backend dependencies (locked)
        entry: uv sync --locked --quiet --project backend
        language: system
        pass_filenames: false
        always_run: true
      - id: backend-format
        name: ruff format --check (backend)
        entry: uv run --directory backend ruff format --check app tools{% if include_postgres %} migrations{% endif %}
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-lint
        name: ruff check (backend)
        entry: uv run --directory backend ruff check app tools{% if include_postgres %} migrations{% endif %}
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-types
        name: ty check (backend)
        entry: uv run --directory backend ty check app tools
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-type-rule-fixture
        name: every ty rule set to error fires on the known-bad file
        entry: uv run --directory backend python tools/check_type_rule_fixture.py
        language: system
        pass_filenames: false
        files: ^backend/(pyproject\.toml|uv\.lock|ty_fixture/|tools/check_type_rule_fixture\.py)$
      - id: backend-house-rules
        name: semgrep house rules
        entry: uv run --directory backend python tools/run_house_rules.py
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-import-contracts
        name: lint-imports
        entry: uv run --directory backend lint-imports
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-dependencies
        name: deptry
        entry: uv run --directory backend deptry .
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-dead-code
        name: vulture, with response, log-event and column fields counted as used
        entry: uv run --directory backend python tools/check_dead_code.py
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-function-names
        name: function names start with a listed verb and return what the verb says
        entry: uv run --directory backend python tools/check_function_names.py
        language: system
        pass_filenames: false
        files: ^backend/.*\.py$
      - id: backend-file-kinds
        name: domain and infrastructure files are of a listed kind
        entry: uv run --directory backend python tools/check_file_kinds.py
        language: system
        pass_filenames: false
        files: ^backend/(app/|tools/check_file_kinds\.py$)
      - id: backend-setting-keys
        name: every setting key is in an example env file
        entry: uv run --directory backend python tools/check_setting_keys.py
        language: system
        pass_filenames: false
        files: ^(backend/app/|\.env.*\.example$)
{%- if include_postgres %}
      - id: backend-migrations
        name: every migration line has one head and no downgrade
        entry: uv run --directory backend python tools/check_migrations.py
        language: system
        pass_filenames: false
        files: ^backend/(migrations/|alembic\.ini$)
{%- endif %}
      - id: backend-openapi-current
        name: OpenAPI document is current and valid
        entry: bash -c 'set -euo pipefail; uv run --project backend python backend/tools/dump_openapi.py backend/openapi.json; uvx openapi-spec-validator==0.9.0 --schema 3.1 backend/openapi.json'
        language: system
        pass_filenames: false
        files: ^backend/
      - id: backend-audit
        name: uv audit (backend, known vulnerabilities)
        entry: uv audit --locked --project backend
        language: system
        pass_filenames: false
        always_run: true
      - id: e2e-sync
        name: e2e dependencies (locked)
        entry: uv sync --locked --quiet --project e2e
        language: system
        pass_filenames: false
        files: ^e2e/
      - id: e2e-format
        name: ruff format --check (e2e)
        entry: uv run --directory e2e ruff format --check .
        language: system
        pass_filenames: false
        files: ^e2e/
      - id: e2e-lint
        name: ruff check (e2e)
        entry: uv run --directory e2e ruff check .
        language: system
        pass_filenames: false
        files: ^e2e/
      - id: e2e-types
        name: ty check (e2e)
        entry: uv run --directory e2e ty check .
        language: system
        pass_filenames: false
        files: ^e2e/
      - id: comments
        name: no comments or docstrings outside the kept kinds
        entry: uv run --project backend python backend/tools/check_comments.py
        language: system
        require_serial: true
        files: \.(py|sh|ya?ml)$|(^|/)(Dockerfile|Caddyfile)$
        exclude: ^(\.copier-answers\.yml$|backend/semgrep/tests/|backend/ty_fixture/|backend/vulture_whitelist\.py$)
      - id: deploy-shell-scripts
        name: shellcheck (deploy)
        entry: uvx --from shellcheck-py==0.11.0.1 shellcheck
        language: system
        files: ^deploy/.*\.sh$
      - id: gitleaks
        name: gitleaks (git history)
        entry: gitleaks git --redact --verbose --no-banner
        language: golang
        language_version: 1.25.4
        additional_dependencies: [github.com/zricethezav/gitleaks/v8@v8.30.1]
        pass_filenames: false
        always_run: true
      - id: workflow-audit
        name: zizmor (workflows and Dependabot config)
        entry: uvx zizmor==1.32.0 --no-progress .github
        language: system
        pass_filenames: false
        files: ^\.github/
      - id: commit-subject
        name: commit subject matches the PR title rule
        entry: uv run --project backend python backend/tools/check_commit_subject.py
        language: system
        stages: [commit-msg]
      - id: commit-subject-rule-readable
        name: the commit-msg hook can read the one title pattern in pr-title.yml
        entry: uv run --project backend python backend/tools/check_commit_subject.py
        language: system
        pass_filenames: false
        files: ^(\.github/workflows/pr-title\.yml|backend/tools/check_commit_subject\.py)$
