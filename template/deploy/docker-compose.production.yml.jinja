services:
  api:
    image: {{ project_slug }}/backend:production
    mem_limit: 512m
    ports: !reset []
    networks:
      reverse_proxy:
        aliases:
          - {{ project_slug }}-api
{%- if include_worker %}

  worker:
    image: {{ project_slug }}/backend:production
    mem_limit: 512m
{%- endif %}
{%- if include_postgres %}

  migrate:
    image: {{ project_slug }}/backend:production
    mem_limit: 512m

  postgres:
    build:
      context: deploy/postgres
    image: {{ project_slug }}/postgres:production
    mem_limit: ${POSTGRES_MEMORY_LIMIT:-1g}
    stop_grace_period: 60s
    env_file:
      - path: ${ {{- environment_prefix }}_POSTGRES_BACKUP_ENVIRONMENT_FILE:?set {{ environment_prefix }}_POSTGRES_BACKUP_ENVIRONMENT_FILE to the backup env file (mode 600, outside the checkout)}
        required: true
    environment:
      PGHOST: /var/run/postgresql
      PGUSER: {{ database_name }}
      PGDATABASE: {{ database_name }}
    networks:
      - backend_data
      - backend_egress
{%- endif %}
{%- if include_object_storage %}

  object-storage:
    profiles:
      - local-object-storage
{%- endif %}

networks:
  reverse_proxy:
    name: ${REVERSE_PROXY_NETWORK:?REVERSE_PROXY_NETWORK is required}
    external: true
