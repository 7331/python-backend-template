from fastapi import APIRouter, Response, status

from app.{{ root_package }}.accounts.dependencies import AccountAccessDependency
from app.{{ root_package }}.accounts.errors import AccountSessionExpiredError, OriginMismatchError, SignInRequiredError
from app.{{ root_package }}.files.dependencies import FileIdPath, FileServiceDependency
from app.{{ root_package }}.files.errors import (
    FileMissingError,
    UploadChangedError,
    UploadNotAllowedError,
    UploadNotFoundError,
)
from app.{{ root_package }}.files.schemas import FileResponse, FileUploadRequest, FileUploadResponse, StoredFileRequest
from app.{{ root_package }}.files.types import StoredFile
from app.infrastructure.object_storage.errors import ObjectStorageUnavailableError
from app.shared.error_responses import describe_error_responses
from app.shared.exception_handlers import NO_STORE_HEADERS
from app.shared.path_params import API_PREFIX

files_router = APIRouter(prefix=API_PREFIX, tags=["files"])

SIGNED_IN_READ_ERRORS = (SignInRequiredError, AccountSessionExpiredError)
SIGNED_IN_CHANGE_ERRORS = (*SIGNED_IN_READ_ERRORS, OriginMismatchError)


def present_file(stored_file: StoredFile) -> FileResponse:
    return FileResponse(
        file_id=stored_file.file_id,
        content_type=stored_file.content_type,
        size_bytes=stored_file.size_bytes,
        created_at=stored_file.created_at,
        download_url=stored_file.download_url.url,
        download_url_expires_at=stored_file.download_url.expires_at,
    )


@files_router.post(
    "/file-uploads",
    status_code=status.HTTP_201_CREATED,
    responses=describe_error_responses(SIGNED_IN_CHANGE_ERRORS),
)
async def create_file_upload(
    upload_request: FileUploadRequest,
    *,
    response: Response,
    account_access: AccountAccessDependency,
    file_service: FileServiceDependency,
) -> FileUploadResponse:
    response.headers.update(NO_STORE_HEADERS)
    file_upload = file_service.create_upload(
        upload_request.content_type, size_bytes=upload_request.size_bytes, account_id=account_access.account_id
    )
    return FileUploadResponse(
        upload_id=file_upload.upload_id,
        upload_url=file_upload.upload_url.url,
        upload_headers={"Content-Type": file_upload.content_type},
        expires_at=file_upload.upload_url.expires_at,
    )


@files_router.post(
    "/files",
    status_code=status.HTTP_201_CREATED,
    responses=describe_error_responses(
        (
            *SIGNED_IN_CHANGE_ERRORS,
            UploadNotFoundError,
            UploadNotAllowedError,
            UploadChangedError,
            ObjectStorageUnavailableError,
        )
    ),
)
async def store_uploaded_file(
    stored_file_request: StoredFileRequest,
    *,
    response: Response,
    account_access: AccountAccessDependency,
    file_service: FileServiceDependency,
) -> FileResponse:
    response.headers.update(NO_STORE_HEADERS)
    return present_file(
        await file_service.store_upload(stored_file_request.upload_id, account_id=account_access.account_id)
    )


@files_router.get(
    "/files/{file_id}", responses=describe_error_responses((*SIGNED_IN_READ_ERRORS, FileMissingError))
)
async def read_file(
    file_id: FileIdPath,
    *,
    response: Response,
    account_access: AccountAccessDependency,
    file_service: FileServiceDependency,
) -> FileResponse:
    response.headers.update(NO_STORE_HEADERS)
    return present_file(await file_service.get_file(file_id, account_id=account_access.account_id))


@files_router.delete(
    "/files/{file_id}",
    status_code=status.HTTP_204_NO_CONTENT,
    responses=describe_error_responses((*SIGNED_IN_CHANGE_ERRORS, FileMissingError, ObjectStorageUnavailableError)),
)
async def delete_file(
    file_id: FileIdPath, *, account_access: AccountAccessDependency, file_service: FileServiceDependency
) -> None:
    await file_service.delete_file(file_id, account_id=account_access.account_id)
