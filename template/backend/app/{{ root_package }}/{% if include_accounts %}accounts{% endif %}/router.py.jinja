from fastapi import APIRouter, Response, status
from pydantic import JsonValue

from app.{{ root_package }}.accounts.dependencies import (
    AccountAccessDependency,
    AccountServiceDependency,
    AccountSessionTokenDependency,
    consume_signed_challenge_in_own_transaction,
)
from app.{{ root_package }}.accounts.enums import ChallengePurpose
from app.{{ root_package }}.accounts.errors import (
    AccountNotFoundError,
    AccountSessionExpiredError,
    PasskeyAlreadyRegisteredError,
    PasskeyChallengeExpiredError,
    PasskeyCredentialIdTooLongError,
    PasskeyResponseInvalidError,
    PasskeyUnknownError,
    SignInRequiredError,
    UsernameTakenError,
)
from app.{{ root_package }}.accounts.schemas import (
    AccountResponse,
    PasskeyAuthenticationRequest,
    PasskeyRegistrationOptionsRequest,
    PasskeyRegistrationRequest,
)
from app.{{ root_package }}.accounts.service import ACCOUNT_SESSION_LIFETIME
from app.{{ root_package }}.accounts.types import ACCOUNT_SESSION_COOKIE_NAME, AccountSummary, StartedAccountSession
from app.lifespan.dependencies import ResourcesDependency
from app.shared.error_responses import describe_error_responses
from app.shared.exception_handlers import NO_STORE_HEADERS
from app.shared.path_params import API_PREFIX

accounts_router = APIRouter(prefix=API_PREFIX, tags=["accounts"])


def present_account(account_summary: AccountSummary) -> AccountResponse:
    return AccountResponse(
        account_id=account_summary.account_public_id,
        username=account_summary.username,
        created_at=account_summary.created_at,
    )


def start_session_response(response: Response, *, started_session: StartedAccountSession) -> AccountResponse:
    response.set_cookie(
        ACCOUNT_SESSION_COOKIE_NAME,
        started_session.session_token.get_secret_value(),
        max_age=int(ACCOUNT_SESSION_LIFETIME.total_seconds()),
        path="/",
        secure=True,
        httponly=True,
        samesite="strict",
    )
    response.headers.update(NO_STORE_HEADERS)
    return present_account(started_session.account)


@accounts_router.post(
    "/accounts/passkey/registration-options", responses=describe_error_responses((UsernameTakenError,))
)
async def create_passkey_registration_options(
    options_request: PasskeyRegistrationOptionsRequest,
    *,
    response: Response,
    account_service: AccountServiceDependency,
) -> dict[str, JsonValue]:
    response.headers.update(NO_STORE_HEADERS)
    return await account_service.create_sign_up_options(options_request.username)


@accounts_router.post(
    "/accounts/passkey/registration",
    status_code=status.HTTP_201_CREATED,
    responses=describe_error_responses(
        (
            PasskeyResponseInvalidError,
            PasskeyChallengeExpiredError,
            PasskeyCredentialIdTooLongError,
            PasskeyAlreadyRegisteredError,
            UsernameTakenError,
        )
    ),
)
async def register_passkey(
    registration_request: PasskeyRegistrationRequest,
    *,
    response: Response,
    resources: ResourcesDependency,
    account_service: AccountServiceDependency,
) -> AccountResponse:
    consumed_challenge = await consume_signed_challenge_in_own_transaction(
        registration_request.credential, purpose=ChallengePurpose.SIGN_UP, resources=resources
    )
    started_session = await account_service.sign_up(
        registration_request.credential, consumed_challenge=consumed_challenge, label=registration_request.label
    )
    return start_session_response(response, started_session=started_session)


@accounts_router.post("/accounts/passkey/authentication-options")
async def create_passkey_authentication_options(
    *, response: Response, account_service: AccountServiceDependency
) -> dict[str, JsonValue]:
    response.headers.update(NO_STORE_HEADERS)
    return await account_service.create_sign_in_options()


@accounts_router.post(
    "/accounts/passkey/authentication",
    responses=describe_error_responses(
        (PasskeyResponseInvalidError, PasskeyChallengeExpiredError, PasskeyUnknownError)
    ),
)
async def authenticate_passkey(
    authentication_request: PasskeyAuthenticationRequest,
    *,
    response: Response,
    resources: ResourcesDependency,
    account_service: AccountServiceDependency,
) -> AccountResponse:
    consumed_challenge = await consume_signed_challenge_in_own_transaction(
        authentication_request.credential, purpose=ChallengePurpose.SIGN_IN, resources=resources
    )
    started_session = await account_service.sign_in_with_passkey(
        authentication_request.credential, consumed_challenge=consumed_challenge
    )
    return start_session_response(response, started_session=started_session)


@accounts_router.post("/accounts/sign-out", status_code=status.HTTP_204_NO_CONTENT)
async def sign_out(
    *, response: Response, session_token: AccountSessionTokenDependency, account_service: AccountServiceDependency
) -> None:
    if session_token is not None:
        await account_service.sign_out(session_token)
    response.delete_cookie(ACCOUNT_SESSION_COOKIE_NAME, path="/", secure=True, httponly=True, samesite="strict")
    response.headers.update(NO_STORE_HEADERS)


@accounts_router.get(
    "/me", responses=describe_error_responses((SignInRequiredError, AccountSessionExpiredError, AccountNotFoundError))
)
async def read_current_account(
    *, response: Response, account_access: AccountAccessDependency, account_service: AccountServiceDependency
) -> AccountResponse:
    response.headers.update(NO_STORE_HEADERS)
    account_summary = await account_service.get_account_summary(account_access.account_id)
    return present_account(account_summary)
