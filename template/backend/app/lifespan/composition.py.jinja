from collections.abc import AsyncGenerator
{% if include_postgres -%}
from contextlib import AsyncExitStack, asynccontextmanager

from app.configuration import (
    ApplicationSettings,
    ConnectionSettings,
    read_application_settings,
    read_connection_settings,
)
{%- else -%}
from contextlib import asynccontextmanager

from app.configuration import read_application_settings
{%- endif %}
{%- if include_object_storage %}
from app.infrastructure.object_storage.client import open_object_storage_client
{%- endif %}
{%- if include_postgres %}
from app.infrastructure.postgres.client import Database
{%- endif %}
from app.infrastructure.rate_limit.limiter_store import InMemoryRateLimiter
{%- if include_postgres %}
from app.infrastructure.rate_limit.postgres_limiter_store import PostgresRateLimiter
{%- endif %}
from app.lifespan.resources import {% if include_worker %}ProcessResources, ProcessRole, {% endif %}Resources
{%- if include_postgres %}
from app.shared.blocking_executor import BlockingExecutor

API_DATABASE_POOL_SIZE = 10
API_DATABASE_MAXIMUM_OVERFLOW = 5
RATE_LIMIT_DATABASE_POOL_SIZE = 2
{%- if include_worker %}
PROCESS_DATABASE_POOL_SIZE = 2
{%- endif %}
FILE_READ_EXECUTOR_WORKERS = 2


def open_file_read_executor(exit_stack: AsyncExitStack) -> BlockingExecutor:
    file_read_executor = BlockingExecutor(executor_name="file_read", maximum_workers=FILE_READ_EXECUTOR_WORKERS)
    exit_stack.callback(file_read_executor.close)
    return file_read_executor


async def open_database(
    exit_stack: AsyncExitStack,
    *,
    application_settings: ApplicationSettings,
    connection_settings: ConnectionSettings,
    file_read_executor: BlockingExecutor,
) -> Database:
    database = Database(
        connection_settings.build_application_database_url().get_secret_value(),
        application_name=f"{application_settings.service_name}-api",
        pool_size=API_DATABASE_POOL_SIZE,
        maximum_overflow=API_DATABASE_MAXIMUM_OVERFLOW,
    )
    exit_stack.push_async_callback(database.close)
    await database.refuse_schema_behind_head(file_read_executor=file_read_executor)
    return database


def open_rate_limiter(
    exit_stack: AsyncExitStack, *, application_settings: ApplicationSettings, connection_settings: ConnectionSettings
) -> PostgresRateLimiter:
    rate_limiter = PostgresRateLimiter(
        connection_settings.build_application_database_url().get_secret_value(),
        application_name=f"{application_settings.service_name}-api-rate-limit",
        pool_size=RATE_LIMIT_DATABASE_POOL_SIZE,
        process_rate_limiter=InMemoryRateLimiter(),
    )
    exit_stack.push_async_callback(rate_limiter.close)
    return rate_limiter
{%- endif %}


@asynccontextmanager
async def open_api_resources() -> AsyncGenerator[Resources]:
    application_settings = read_application_settings()
{%- if include_postgres %}
    connection_settings = read_connection_settings()
    async with AsyncExitStack() as exit_stack:
        file_read_executor = open_file_read_executor(exit_stack)
        yield Resources(
            file_read_executor=file_read_executor,
            database=await open_database(
                exit_stack,
                application_settings=application_settings,
                connection_settings=connection_settings,
                file_read_executor=file_read_executor,
            ),
{%- if include_object_storage %}
            object_storage=open_object_storage_client(exit_stack),
{%- endif %}
            rate_limiter=open_rate_limiter(
                exit_stack, application_settings=application_settings, connection_settings=connection_settings
            ),
            trusted_proxy_networks=application_settings.list_trusted_proxy_networks(),
        )
{%- else %}
    yield Resources(
        rate_limiter=InMemoryRateLimiter(),
        trusted_proxy_networks=application_settings.list_trusted_proxy_networks(),
    )
{%- endif %}
{%- if include_worker %}


@asynccontextmanager
async def open_process_resources(*, process_role: ProcessRole) -> AsyncGenerator[ProcessResources]:
    application_settings = read_application_settings()
    async with AsyncExitStack() as exit_stack:
        file_read_executor = open_file_read_executor(exit_stack)
        database = Database(
            read_connection_settings().build_application_database_url().get_secret_value(),
            application_name=f"{application_settings.service_name}-{process_role.value}",
            pool_size=PROCESS_DATABASE_POOL_SIZE,
            maximum_overflow=0,
        )
        exit_stack.push_async_callback(database.close)
        await database.refuse_schema_behind_head(file_read_executor=file_read_executor)
        yield ProcessResources(file_read_executor=file_read_executor, database=database)
{%- endif %}
