from enum import StrEnum
{% endif -%}
from ipaddress import IPv4Network, IPv6Network
from typing import TypedDict

from pydantic import BaseModel, ConfigDict

{% if include_postgres -%}
from app.infrastructure.postgres.client import Database
{% endif -%}
from app.infrastructure.rate_limit.limiter_store import InMemoryRateLimiter
{%- if include_postgres %}
from app.shared.blocking_executor import BlockingExecutor
{%- endif %}


class Resources(BaseModel):
    model_config = ConfigDict(frozen=True, arbitrary_types_allowed=True)
{% if include_postgres %}
    file_read_executor: BlockingExecutor
    database: Database
{%- endif %}
    rate_limiter: InMemoryRateLimiter
    trusted_proxy_networks: tuple[IPv4Network | IPv6Network, ...]


class ApiLifespanState(TypedDict):
    resources: Resources
{%- if include_worker %}


class ProcessRole(StrEnum):
    WORKER = "worker"
    COMMAND = "command"


class ProcessResources(BaseModel):
    model_config = ConfigDict(frozen=True, arbitrary_types_allowed=True)

    file_read_executor: BlockingExecutor
    database: Database
{%- endif %}
