import ast
from pathlib import Path
import sys

from alembic.config import Config
from alembic.script import ScriptDirectory

BACKEND_DIRECTORY = Path(__file__).resolve().parents[1]
VERSIONS_DIRECTORY = BACKEND_DIRECTORY / "migrations" / "versions"


def list_heads() -> list[str]:
    return sorted(ScriptDirectory.from_config(Config(str(BACKEND_DIRECTORY / "alembic.ini"))).get_heads())


def downgrade_raises(revision_path: Path) -> bool:
    return any(
        isinstance(node, ast.FunctionDef)
        and node.name == "downgrade"
        and any(isinstance(statement, ast.Raise) for statement in node.body)
        for node in ast.parse(revision_path.read_text(encoding="utf-8")).body
    )


def main() -> None:
    heads = list_heads()
    revision_paths = sorted(VERSIONS_DIRECTORY.glob("*.py"))
    problems = [
        f"{revision_path.name}: downgrade() must raise, because migrations are forward only"
        for revision_path in revision_paths
        if not downgrade_raises(revision_path)
    ]
    if len(heads) != 1:
        problems.append(f"the history must have exactly one head, found {len(heads)}: {', '.join(heads)}")
    for problem in problems:
        print(problem)
    print(f"migrations: {len(revision_paths)} revisions, {len(heads)} heads, {len(problems)} problems")
    sys.exit(1 if problems else 0)


if __name__ == "__main__":
    main()
