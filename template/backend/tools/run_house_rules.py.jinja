from pathlib import Path
import re
import resource
import subprocess
import sys

from pydantic import BaseModel, ConfigDict, Field, JsonValue

RULE_FILES = ("semgrep/house-rules.yaml", "semgrep/naming-rules.yaml")
KNOWN_BAD_FIXTURE = "semgrep/tests/known_bad.py"
KNOWN_GOOD_FIXTURE = "semgrep/tests/known_good.py"
RULE_ID = re.compile(r"^  - id: (\S+)$", re.MULTILINE)
SEMGREP_COMMAND = (
    "uvx",
    "semgrep==1.183.0",
    "scan",
    *(argument for rule_file in RULE_FILES for argument in ("--config", rule_file)),
    "--metrics=off",
    "--strict",
    "--quiet",
    "--timeout",
    "60",
    "--json",
    "app",
{%- if include_postgres %}
    "migrations",
{%- endif %}
    "tools",
    KNOWN_BAD_FIXTURE,
    KNOWN_GOOD_FIXTURE,
)
SEMGREP_TIMEOUT_SECONDS = 600
MESSAGE_PREVIEW_LENGTH = 200


class SemgrepPosition(BaseModel):
    model_config = ConfigDict(extra="ignore")

    line: int


class SemgrepFindingExtra(BaseModel):
    model_config = ConfigDict(extra="ignore")

    message: str = ""


class SemgrepFinding(BaseModel):
    model_config = ConfigDict(extra="ignore")

    check_id: str
    path: str
    start: SemgrepPosition
    extra: SemgrepFindingExtra


class SemgrepError(BaseModel):
    model_config = ConfigDict(extra="ignore")

    error_type: JsonValue = Field(default="", validation_alias="type")
    path: str = ""
    message: JsonValue = ""


class SemgrepReport(BaseModel):
    model_config = ConfigDict(extra="ignore")

    results: list[SemgrepFinding]
    errors: list[SemgrepError]


def lift_stack_limit() -> None:
    _, hard_limit = resource.getrlimit(resource.RLIMIT_STACK)
    resource.setrlimit(resource.RLIMIT_STACK, (hard_limit, hard_limit))


def run_house_rules() -> SemgrepReport:
    lift_stack_limit()
    completed = subprocess.run(  # noqa: S603  # a fixed command, no outside input
        SEMGREP_COMMAND,
        capture_output=True,
        timeout=SEMGREP_TIMEOUT_SECONDS,
        check=False,
    )
    if not completed.stdout:
        sys.stderr.write(completed.stderr.decode(errors="replace"))
        raise SystemExit(completed.returncode or 1)
    return SemgrepReport.model_validate_json(completed.stdout)


def list_rule_ids() -> set[str]:
    return {
        rule_id for rule_file in RULE_FILES for rule_id in RULE_ID.findall(Path(rule_file).read_text(encoding="utf-8"))
    }


def main() -> None:
    report = run_house_rules()
    silent_rule_ids = sorted(
        list_rule_ids()
        - {finding.check_id.rsplit(".", maxsplit=1)[-1] for finding in report.results if finding.path == KNOWN_BAD_FIXTURE}
    )
    findings = [finding for finding in report.results if finding.path != KNOWN_BAD_FIXTURE]
    for finding in findings:
        print(
            f"{finding.path}:{finding.start.line} {finding.check_id}: {finding.extra.message[:MESSAGE_PREVIEW_LENGTH]}"
        )
    for error in report.errors:
        print(
            f"semgrep {str(error.error_type)[:MESSAGE_PREVIEW_LENGTH]} {error.path}: {str(error.message)[:MESSAGE_PREVIEW_LENGTH]}"
        )
    for silent_rule_id in silent_rule_ids:
        print(f"{silent_rule_id} finds nothing in {KNOWN_BAD_FIXTURE}: the rule no longer matches, or has no violation there")
    print(
        f"house rules: {len(findings)} findings, {len(report.errors)} errors, {len(silent_rule_ids)} rules silent on the known-bad file"
    )
    sys.exit(1 if findings or report.errors or silent_rule_ids else 0)


if __name__ == "__main__":
    main()
