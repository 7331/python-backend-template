from alembic import context
from psycopg import sql
from sqlalchemy import Connection, text
from sqlalchemy.ext.asyncio import create_async_engine
import uvloop

{% if include_accounts -%}
from app.{{ root_package }}.accounts import models as account_models
{% endif -%}
from app.infrastructure.postgres.models import Base
from app.infrastructure.rate_limit import models as rate_limit_models
{%- if include_worker %}
from app.infrastructure.task_queue import models as job_models
{%- endif %}
from app.configuration import APPLICATION_DATABASE_ROLE, read_migration_connection_settings

{% if include_accounts and include_worker -%}
REGISTERED_MODEL_MODULES = (account_models, job_models, rate_limit_models)
{% elif include_accounts -%}
REGISTERED_MODEL_MODULES = (account_models, rate_limit_models)
{% elif include_worker -%}
REGISTERED_MODEL_MODULES = (job_models, rate_limit_models)
{% else -%}
REGISTERED_MODEL_MODULES = (rate_limit_models,)
{% endif -%}
target_metadata = Base.metadata


def run_migrations_on_connection(connection: Connection) -> None:
    context.configure(connection=connection, target_metadata=target_metadata, transaction_per_migration=True)
    with context.begin_transaction():
        context.run_migrations()


def set_application_role_password(connection: Connection, *, application_database_password: str) -> None:
    role_exists = connection.scalar(
        text("SELECT EXISTS (SELECT FROM pg_roles WHERE rolname = :role_name)"),
        {"role_name": APPLICATION_DATABASE_ROLE},
    )
    if not role_exists:
        return
    driver_connection = connection.connection.driver_connection
    password_verifier = driver_connection.pgconn.encrypt_password(
        application_database_password.encode(), APPLICATION_DATABASE_ROLE.encode(), b"scram-sha-256"
    )
    alter_role_statement = sql.SQL("ALTER ROLE {role} PASSWORD {password_verifier}").format(
        role=sql.Identifier(APPLICATION_DATABASE_ROLE), password_verifier=sql.Literal(password_verifier.decode())
    )
    connection.exec_driver_sql(alter_role_statement.as_string(driver_connection))


async def run_async_migrations() -> None:
    migration_connection_settings = read_migration_connection_settings()
    engine = create_async_engine(migration_connection_settings.build_migration_database_url().get_secret_value())
    async with engine.connect() as connection:
        await connection.run_sync(run_migrations_on_connection)
    async with engine.begin() as connection:
        await connection.run_sync(
            set_application_role_password,
            application_database_password=migration_connection_settings.application_database_password.get_secret_value(),
        )
    await engine.dispose()


uvloop.run(run_async_migrations())
