{{ environment_prefix }}_ACCOUNTS_RELYING_PARTY_NAME={{ project_slug }}
{{ environment_prefix }}_ACCOUNTS_PUBLIC_BASE_URL=http://localhost:8000
{%- endif %}
{%- if include_worker %}
{{ environment_prefix }}_TASK_QUEUE_POLL_INTERVAL_SECONDS=1
