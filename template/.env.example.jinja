{%- if include_postgres -%}
{{ environment_prefix }}_APPLICATION_DATABASE_PASSWORD=
{{ environment_prefix }}_DATABASE_HOST=postgres
{{ environment_prefix }}_DATABASE_PORT=5432
{% endif -%}
{{ environment_prefix }}_SERVICE_NAME={{ project_slug }}
{{ environment_prefix }}_TRUSTED_PROXY_ADDRESSES=
