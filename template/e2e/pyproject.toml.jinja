[project]
name = "{{ project_slug }}-e2e"
version = "0.1.0"
description = "End-to-end flows of {{ project_slug }} against a running compose stack"
requires-python = ">=3.15,<3.16"
{%- if include_accounts %}
dependencies = [
    "cbor2==6.1.5",
    "cryptography==50.0.2",
    "pydantic==2.14.2",
]
{%- else %}
dependencies = [
    "pydantic==2.14.2",
]
{%- endif %}

[dependency-groups]
dev = [
    "ruff>=0.17.3",
    "ty==0.0.96",
]

[tool.uv]
package = false
exclude-newer = "7 days"

[tool.ruff]
line-length = 120
target-version = "py315"

[tool.ruff.lint]
select = ["ALL"]
ignore = ["D", "CPY", "COM812", "E501", "TRY003", "EM101", "EM102", "PLR2004", "INP001", "T201", "S603", "S607", "PLR0913", "TC001", "TC002", "TC003"]

[tool.ruff.lint.pylint]
max-positional-args = 1

[tool.ruff.lint.isort]
force-sort-within-sections = true

[tool.ty.environment]
python-version = "3.15"
