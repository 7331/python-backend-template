from collections.abc import Mapping
from pathlib import Path
import secrets
import sys
import tempfile
import time
import urllib.error
import urllib.request

from pydantic import BaseModel, ConfigDict

from flow_report import FlowCheckFailedError, FlowReport
from http_client import HttpReply, send_http_request, send_json_request
from stack_commands import (
    ComposeStack,
    StackCommandFailedError,
    destroy_stack,
    find_free_local_port,
    prepare_compose_stack,
    read_database_value,
    run_compose,
    start_stack,
)

DOWNLOAD_URL_LIFETIME_SECONDS = 5
OBJECT_STORAGE_FLOW_ENVIRONMENT_LINES = (
    f"{{ environment_prefix }}_OBJECT_STORAGE_DOWNLOAD_URL_LIFETIME_SECONDS={DOWNLOAD_URL_LIFETIME_SECONDS}",
)
API_REQUEST_BODY_LIMIT_BYTES = 64 * 1024
FILE_SIZE_BYTES = 200_000
MAXIMUM_FILE_SIZE_BYTES = 10 * 1024 * 1024
FILE_CONTENT_TYPE = "image/png"
REFUSED_CONTENT_TYPE = "text/html"
BUCKET_REQUEST_TIMEOUT_SECONDS = 20
COMPOSE_COMMAND_TIMEOUT_SECONDS = 60
BUCKET_DIRECTORY = "/data/{{ project_slug }}"


class BucketReply(BaseModel):
    model_config = ConfigDict(frozen=True)

    status_code: int
    content_type: str | None
    content_disposition: str | None
    body: bytes


class FileUploadBody(BaseModel):
    model_config = ConfigDict(frozen=True)

    upload_id: str
    upload_url: str
    upload_headers: dict[str, str]


class FileBody(BaseModel):
    model_config = ConfigDict(frozen=True, extra="ignore")

    file_id: str
    content_type: str
    size_bytes: int
    download_url: str


class ErrorBody(BaseModel):
    model_config = ConfigDict(frozen=True, extra="ignore")

    code: str


class ErrorReplyBody(BaseModel):
    model_config = ConfigDict(frozen=True)

    error: ErrorBody


def add_object_storage_flow_settings(compose_stack: ComposeStack) -> None:
    with compose_stack.environment_file.open("a") as environment_file:
        environment_file.write("\n".join(OBJECT_STORAGE_FLOW_ENVIRONMENT_LINES) + "\n")


def send_bucket_request(url: str, *, method: str, headers: Mapping[str, str], body: bytes | None) -> BucketReply:
    try:
        with urllib.request.urlopen(  # noqa: S310  # the URL is one the API signed for the stack's own bucket
            urllib.request.Request(url, data=body, headers=dict(headers), method=method),  # noqa: S310  # same URL
            timeout=BUCKET_REQUEST_TIMEOUT_SECONDS,
        ) as response:
            return BucketReply(
                status_code=response.status,
                content_type=response.headers.get("Content-Type"),
                content_disposition=response.headers.get("Content-Disposition"),
                body=response.read(),
            )
    except urllib.error.HTTPError as error_response:
        return BucketReply(
            status_code=error_response.code, content_type=None, content_disposition=None, body=error_response.read()
        )


def read_error_code(reply: HttpReply) -> str:
    return ErrorReplyBody.model_validate_json(reply.body).error.code


def request_file_upload(api_publish_port: int, *, content_type: str, size_bytes: int) -> HttpReply:
    return send_json_request(
        "/api/v1/file-uploads",
        api_publish_port=api_publish_port,
        method="POST",
        headers={},
        json_body={"content_type": content_type, "size_bytes": size_bytes},
    )


def create_file_upload(flow_report: FlowReport, *, api_publish_port: int, check_name: str) -> FileUploadBody:
    upload_reply = request_file_upload(api_publish_port, content_type=FILE_CONTENT_TYPE, size_bytes=FILE_SIZE_BYTES)
    flow_report.require_check(
        check_name,
        passed=upload_reply.status_code == 201,
        detail=f"{upload_reply.status_code} for a {FILE_SIZE_BYTES} byte {FILE_CONTENT_TYPE}",
    )
    return FileUploadBody.model_validate_json(upload_reply.body)


def store_uploaded_file(api_publish_port: int, *, upload_id: str) -> HttpReply:
    return send_json_request(
        "/api/v1/files",
        api_publish_port=api_publish_port,
        method="POST",
        headers={},
        json_body={"upload_id": upload_id},
    )


def read_file(api_publish_port: int, *, file_id: str) -> HttpReply:
    return send_http_request(
        f"/api/v1/files/{file_id}", api_publish_port=api_publish_port, method="GET", headers={}, body=None
    )


def delete_file(api_publish_port: int, *, file_id: str) -> HttpReply:
    return send_http_request(
        f"/api/v1/files/{file_id}", api_publish_port=api_publish_port, method="DELETE", headers={}, body=None
    )


def list_bucket_files(compose_stack: ComposeStack) -> list[str]:
    return run_compose(
        ["exec", "-T", "object-storage", "find", BUCKET_DIRECTORY, "-type", "f"],
        compose_stack=compose_stack,
        timeout_seconds=COMPOSE_COMMAND_TIMEOUT_SECONDS,
    ).split()


def check_api_refuses_what_it_would_not_sign(flow_report: FlowReport, *, api_publish_port: int) -> None:
    wrong_type_reply = request_file_upload(
        api_publish_port, content_type=REFUSED_CONTENT_TYPE, size_bytes=FILE_SIZE_BYTES
    )
    flow_report.record_check(
        "the API signs no upload of a content type off its list",
        passed=wrong_type_reply.status_code == 400 and read_error_code(wrong_type_reply) == "validation_error",
        detail=f"{wrong_type_reply.status_code} {read_error_code(wrong_type_reply)} for {REFUSED_CONTENT_TYPE}",
    )
    oversized_reply = request_file_upload(
        api_publish_port, content_type=FILE_CONTENT_TYPE, size_bytes=MAXIMUM_FILE_SIZE_BYTES + 1
    )
    flow_report.record_check(
        "the API signs no upload over the size limit",
        passed=oversized_reply.status_code == 400 and read_error_code(oversized_reply) == "validation_error",
        detail=f"{oversized_reply.status_code} {read_error_code(oversized_reply)} for {MAXIMUM_FILE_SIZE_BYTES + 1} bytes",
    )
    never_uploaded = create_file_upload(
        flow_report, api_publish_port=api_publish_port, check_name="upload signed and then never used"
    )
    never_uploaded_reply = store_uploaded_file(api_publish_port, upload_id=never_uploaded.upload_id)
    flow_report.record_check(
        "an upload that never reached the bucket can't be stored",
        passed=never_uploaded_reply.status_code == 404 and read_error_code(never_uploaded_reply) == "upload_not_found",
        detail=f"{never_uploaded_reply.status_code} {read_error_code(never_uploaded_reply)}",
    )


def check_bucket_refuses_what_was_not_signed(
    flow_report: FlowReport, *, file_upload: FileUploadBody, file_bytes: bytes
) -> None:
    oversized_reply = send_bucket_request(
        file_upload.upload_url, method="PUT", headers=file_upload.upload_headers, body=file_bytes + b"\x00"
    )
    flow_report.record_check(
        "the bucket refuses one byte more than was signed",
        passed=oversized_reply.status_code == 403,
        detail=f"{oversized_reply.status_code} for {len(file_bytes) + 1} bytes on a URL signed for {len(file_bytes)}",
    )
    wrong_type_reply = send_bucket_request(
        file_upload.upload_url, method="PUT", headers={"Content-Type": REFUSED_CONTENT_TYPE}, body=file_bytes
    )
    flow_report.record_check(
        "the bucket refuses another content type than was signed",
        passed=wrong_type_reply.status_code == 403,
        detail=f"{wrong_type_reply.status_code} for {REFUSED_CONTENT_TYPE} on a URL signed for {FILE_CONTENT_TYPE}",
    )
    other_key_reply = send_bucket_request(
        file_upload.upload_url.replace(file_upload.upload_id, secrets.token_urlsafe(24)),
        method="PUT",
        headers=file_upload.upload_headers,
        body=file_bytes,
    )
    flow_report.record_check(
        "the bucket refuses an upload URL moved to another key",
        passed=other_key_reply.status_code == 403,
        detail=f"{other_key_reply.status_code}",
    )


def check_upload_and_download(
    flow_report: FlowReport,
    *,
    compose_stack: ComposeStack,
    api_publish_port: int,
    file_upload: FileUploadBody,
    file_bytes: bytes,
) -> FileBody:
    upload_reply = send_bucket_request(
        file_upload.upload_url, method="PUT", headers=file_upload.upload_headers, body=file_bytes
    )
    flow_report.require_check(
        "upload straight to the bucket",
        passed=upload_reply.status_code == 200,
        detail=(
            f"{upload_reply.status_code} for {len(file_bytes)} bytes, over the API's "
            f"{API_REQUEST_BODY_LIMIT_BYTES} byte body limit"
        ),
    )
    stored_reply = store_uploaded_file(api_publish_port, upload_id=file_upload.upload_id)
    flow_report.require_check(
        "uploaded file stored", passed=stored_reply.status_code == 201, detail=f"{stored_reply.status_code}"
    )
    stored_file = FileBody.model_validate_json(stored_reply.body)
    flow_report.record_check(
        "the stored size and content type are the bucket's",
        passed=stored_file.size_bytes == len(file_bytes) and stored_file.content_type == FILE_CONTENT_TYPE,
        detail=f"{stored_file.size_bytes} bytes, {stored_file.content_type}",
    )
    repeated_reply = store_uploaded_file(api_publish_port, upload_id=file_upload.upload_id)
    flow_report.record_check(
        "storing the same upload twice gives the same file",
        passed=repeated_reply.status_code == 201
        and FileBody.model_validate_json(repeated_reply.body).file_id == stored_file.file_id
        and read_database_value("SELECT count(*) FROM files;", compose_stack=compose_stack) == "1",
        detail=f"{repeated_reply.status_code}, one row",
    )
    download_reply = send_bucket_request(stored_file.download_url, method="GET", headers={}, body=None)
    flow_report.record_check(
        "download returns the uploaded bytes as an attachment",
        passed=download_reply.status_code == 200
        and download_reply.body == file_bytes
        and download_reply.content_type == FILE_CONTENT_TYPE
        and download_reply.content_disposition == "attachment",
        detail=(
            f"{download_reply.status_code}, {len(download_reply.body)} bytes, same bytes: "
            f"{download_reply.body == file_bytes}, {download_reply.content_type}, {download_reply.content_disposition}"
        ),
    )
    return stored_file


def check_download_urls_are_refused(flow_report: FlowReport, *, api_publish_port: int, stored_file: FileBody) -> None:
    unsigned_reply = send_bucket_request(stored_file.download_url.split("?", 1)[0], method="GET", headers={}, body=None)
    flow_report.record_check(
        "the bucket refuses a download without a signature",
        passed=unsigned_reply.status_code == 403,
        detail=f"{unsigned_reply.status_code}",
    )
    tampered_reply = send_bucket_request(
        stored_file.download_url.replace(f"files/{stored_file.file_id}", f"pending/{stored_file.file_id}"),
        method="GET",
        headers={},
        body=None,
    )
    flow_report.record_check(
        "the bucket refuses a download URL moved to another key",
        passed=tampered_reply.status_code == 403,
        detail=f"{tampered_reply.status_code}",
    )
    time.sleep(DOWNLOAD_URL_LIFETIME_SECONDS + 2)
    expired_reply = send_bucket_request(stored_file.download_url, method="GET", headers={}, body=None)
    flow_report.record_check(
        "the bucket refuses an expired download URL",
        passed=expired_reply.status_code == 403,
        detail=f"{expired_reply.status_code}, {DOWNLOAD_URL_LIFETIME_SECONDS + 2} s after a {DOWNLOAD_URL_LIFETIME_SECONDS} s URL was signed",
    )
    fresh_file_reply = read_file(api_publish_port, file_id=stored_file.file_id)
    fresh_download_reply = send_bucket_request(
        FileBody.model_validate_json(fresh_file_reply.body).download_url, method="GET", headers={}, body=None
    )
    flow_report.record_check(
        "a newly signed download URL works",
        passed=fresh_file_reply.status_code == 200 and fresh_download_reply.status_code == 200,
        detail=f"file {fresh_file_reply.status_code}, download {fresh_download_reply.status_code}",
    )


def check_delete_removes_object_and_row(
    flow_report: FlowReport, *, compose_stack: ComposeStack, api_publish_port: int, stored_file: FileBody
) -> None:
    file_reply = read_file(api_publish_port, file_id=stored_file.file_id)
    unexpired_download_url = FileBody.model_validate_json(file_reply.body).download_url
    delete_reply = delete_file(api_publish_port, file_id=stored_file.file_id)
    flow_report.require_check(
        "file deleted", passed=delete_reply.status_code == 204, detail=f"{delete_reply.status_code}"
    )
    deleted_download_reply = send_bucket_request(unexpired_download_url, method="GET", headers={}, body=None)
    flow_report.record_check(
        "an unexpired download URL finds no object after the delete",
        passed=deleted_download_reply.status_code == 404,
        detail=f"{deleted_download_reply.status_code}",
    )
    missing_file_reply = read_file(api_publish_port, file_id=stored_file.file_id)
    repeated_delete_reply = delete_file(api_publish_port, file_id=stored_file.file_id)
    flow_report.record_check(
        "the API no longer knows the file",
        passed=missing_file_reply.status_code == 404
        and read_error_code(missing_file_reply) == "file_not_found"
        and repeated_delete_reply.status_code == 404,
        detail=f"read {missing_file_reply.status_code} {read_error_code(missing_file_reply)}, second delete {repeated_delete_reply.status_code}",
    )
    row_count = read_database_value("SELECT count(*) FROM files;", compose_stack=compose_stack)
    bucket_files = list_bucket_files(compose_stack)
    flow_report.record_check(
        "the row and every copy of the object are gone",
        passed=row_count == "0" and not bucket_files,
        detail=f"{row_count} rows in files, {len(bucket_files)} objects left in {BUCKET_DIRECTORY}",
    )


def run_object_storage_flow() -> bool:
    flow_report = FlowReport()
    api_publish_port = find_free_local_port()
    file_bytes = secrets.token_bytes(FILE_SIZE_BYTES)
    with tempfile.TemporaryDirectory() as environment_directory:
        compose_stack = prepare_compose_stack(Path(environment_directory), api_publish_port=api_publish_port)
        add_object_storage_flow_settings(compose_stack)
        try:
            start_stack(compose_stack)
            check_api_refuses_what_it_would_not_sign(flow_report, api_publish_port=api_publish_port)
            file_upload = create_file_upload(flow_report, api_publish_port=api_publish_port, check_name="upload signed")
            check_bucket_refuses_what_was_not_signed(flow_report, file_upload=file_upload, file_bytes=file_bytes)
            stored_file = check_upload_and_download(
                flow_report,
                compose_stack=compose_stack,
                api_publish_port=api_publish_port,
                file_upload=file_upload,
                file_bytes=file_bytes,
            )
            check_download_urls_are_refused(flow_report, api_publish_port=api_publish_port, stored_file=stored_file)
            check_delete_removes_object_and_row(
                flow_report, compose_stack=compose_stack, api_publish_port=api_publish_port, stored_file=stored_file
            )
        except StackCommandFailedError as stack_error:
            flow_report.record_check("stack", passed=False, detail=str(stack_error))
        except FlowCheckFailedError:
            pass
        finally:
            destroy_stack(compose_stack)
    return flow_report.has_passed()


if __name__ == "__main__":
    sys.exit(0 if run_object_storage_flow() else 1)
