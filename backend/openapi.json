      "JsonValue": {},
      "PasskeyAuthenticationRequest": {
        "additionalProperties": false,
        "properties": {
          "credential": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object"
          }
        },
        "required": [
          "credential"
        ],
        "type": "object"
      },
      "PasskeyRegistrationOptionsRequest": {
        "additionalProperties": false,
        "properties": {
          "username": {
            "pattern": "^[a-z0-9_]{3,32}$",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "type": "object"
      },
      "PasskeyRegistrationRequest": {
        "additionalProperties": false,
        "properties": {
          "credential": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object"
          },
          "label": {
            "default": "passkey",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "type": "string"
          }
        },
        "required": [
          "credential"
        ],
        "type": "object"
      },
      "StoredFileRequest": {
        "additionalProperties": false,
        "properties": {
          "upload_id": {
            "pattern": "^[A-Za-z0-9_-]{32}$",
            "type": "string"
          }
        },
        "required": [
          "upload_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "accountSession": {
        "description": "The session cookie a passkey sign-in sets. A change also needs Origin to be this site's own.",
