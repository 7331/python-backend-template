      "AccountResponse": {
        "properties": {
          "account_id": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "username",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          },
          "parameters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorParameters"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorDetailCode"
          },
          "pointer": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "pointer"
        ],
        "type": "object"
      },
      "ErrorDetailCode": {
        "enum": [
          "required",
          "unknown_field",
          "wrong_type",
          "too_short",
          "too_long",
          "pattern_mismatch",
          "out_of_range",
          "not_allowed",
          "invalid_value"
        ],
        "type": "string"
      },
      "ErrorParameters": {
        "properties": {},
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FileContentType": {
        "enum": [
          "image/png",
          "image/jpeg",
          "application/pdf"
        ],
        "type": "string"
      },
      "FileResponse": {
        "properties": {
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "download_url_expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "file_id": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "file_id",
          "content_type",
          "size_bytes",
          "created_at",
          "download_url",
          "download_url_expires_at"
        ],
        "type": "object"
      },
      "FileUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "$ref": "#/components/schemas/FileContentType"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 10485760.0,
